# Copy this file to ".env" and change the values. Never commit ".env".

# The code everyone must enter to play. At least 8 characters.
# Longer is safer, e.g. four random words: "maple-rocket-tuesday-lantern".
ACCESS_CODE=change-me

# Port on the server where your nginx forwards traffic (only reachable from the server itself).
PORT=8080

# Days before players must enter the code again.
SESSION_DAYS=30
